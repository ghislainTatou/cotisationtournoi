# Supabase -> bouton "Connect" du projet (ou Project Settings > General)
# Important : uniquement la base, SANS /rest/v1 à la fin.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase -> Project Settings > API Keys > Secret key (commence par sb_secret_...)
# Cette clé reste côté serveur : ne la mets jamais dans une variable NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Ancienne clé service_role (commence par eyJ...). Encore acceptée, mais dépréciée par Supabase.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Une longue chaîne aléatoire pour signer les sessions (à garder secrète)
SESSION_SECRET=change-moi-avec-une-longue-chaine-aleatoire

# Compte administrateur créé automatiquement au premier login
ADMIN_PHONE=+2250700000000
ADMIN_PASSWORD=Admin@2026
ADMIN_NAME=Administrateur
